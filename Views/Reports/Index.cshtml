@model ExpenseTracker.Models.ReportsViewModel
@{
    ViewData["Title"] = "Transaction Reports";
    var accountParam = (int)Model.SelectedAccount;
    var periodParam = Model.SelectedPeriod;
}

<div class="container reports-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-3 no-print">
        <div>
            <h1 class="page-title">Transaction Reports</h1>
            <div class="title-gold-bar"></div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center gap-2">
            <a class="btn-secondary-theme" href="/Reports/DownloadCsv?account=@accountParam&period=@periodParam" title="Download report as CSV file">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download CSV
            </a>
            <button type="button" class="btn-primary-theme" onclick="printReport()" title="Print or save as PDF via browser print dialog">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                Print / Save as PDF
            </button>
        </div>
    </div>

    <!-- Filter Controls (Account & Period Switchers) -->
    <div class="filter-row no-print">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <!-- Account Switcher -->
            <div class="pill-switcher">
                <a class="pill-btn @(Model.SelectedAccount == ExpenseTracker.Models.AccountType.Personal ? "active" : "")"
                   href="/Reports?account=1&period=@periodParam">Personal</a>
                <a class="pill-btn @(Model.SelectedAccount == ExpenseTracker.Models.AccountType.Business ? "active" : "")"
                   href="/Reports?account=2&period=@periodParam">Business</a>
            </div>

            <!-- Period Filter Pills -->
            <div class="pill-switcher">
                <a class="pill-btn @(periodParam == "1m" ? "active" : "")"
                   href="/Reports?account=@accountParam&period=1m">Last 1 Month</a>
                <a class="pill-btn @(periodParam == "2m" ? "active" : "")"
                   href="/Reports?account=@accountParam&period=2m">Last 2 Months</a>
                <a class="pill-btn @(periodParam == "3m" ? "active" : "")"
                   href="/Reports?account=@accountParam&period=3m">Last 3 Months</a>
                <a class="pill-btn @(periodParam == "6m" ? "active" : "")"
                   href="/Reports?account=@accountParam&period=6m">Last 6 Months</a>
                <a class="pill-btn @(periodParam == "all" ? "active" : "")"
                   href="/Reports?account=@accountParam&period=all">All History</a>
            </div>
        </div>

        <div class="filter-note">
            Showing @Model.AccountName records &bull; @Model.PeriodLabel
        </div>
    </div>

    <!-- Print Only Header -->
    <div class="print-only-header d-none d-print-block">
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
            <div>
                <h2 style="font-family: var(--font-serif); color: var(--primary-green); margin: 0 0 4px 0; font-size: 1.8rem;">ExpenseTracker</h2>
                <div style="font-size: 1.1rem; font-weight: 600; color: #2C2C26;">Financial Statement &bull; @Model.AccountName Account</div>
                <div style="font-size: 0.85rem; color: #7A7265;">Period: @Model.PeriodLabel @(Model.StartDate.HasValue ? $"({Model.StartDate.Value:yyyy-MM-dd} to {Model.EndDate:yyyy-MM-dd})" : "(All Time)")</div>
            </div>
            <div class="text-end" style="font-size: 0.8rem; color: #7A7265;">
                <div>Generated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                <div>User: @(User.Identity?.Name ?? "User")</div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="metric-grid mb-4">
        <!-- Total Income -->
        <div class="metric-card accent-income">
            <div class="metric-label">Total Income</div>
            <div class="metric-value val-income">₹ @(Model.TotalIncome.ToString("N2"))</div>
            <div class="metric-trend trend-positive">
                @Model.PeriodLabel income
            </div>
        </div>

        <!-- Total Expense -->
        <div class="metric-card accent-expense">
            <div class="metric-label">Total Expense</div>
            <div class="metric-value val-expense">₹ @(Model.TotalExpense.ToString("N2"))</div>
            <div class="metric-trend trend-neutral">
                @Model.PeriodLabel spending
            </div>
        </div>

        <!-- Net Balance -->
        <div class="metric-card accent-balance">
            <div class="metric-label">Net Balance</div>
            <div class="metric-value @(Model.NetBalance >= 0 ? "val-balance" : "val-expense")">
                ₹ @(Model.NetBalance.ToString("N2"))
            </div>
            <div class="metric-trend @(Model.NetBalance >= 0 ? "trend-positive" : "trend-neutral")">
                @(Model.NetBalance >= 0 ? "▲ Surplus" : "▼ Deficit") for period
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="table-card">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 16%;">Date</th>
                    <th style="width: 14%;">Type</th>
                    <th style="width: 22%;">Category</th>
                    <th style="width: 30%;">Description</th>
                    <th style="width: 18%;" class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions != null && Model.Transactions.Any())
                {
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge-cat-pill" style="@(t.Type == ExpenseTracker.Models.TransactionType.Income ? "background: #DCEDE3; color: #164E3A;" : "background: #FAEAEE; color: #6E2237;")">
                                    @t.Type
                                </span>
                            </td>
                            <td>
                                <span class="badge-cat-pill" style="background: #F3ECE0; color: #4A453E;">
                                    @(t.Category?.Name ?? "Uncategorized")
                                </span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                            <td class="text-end @(t.Type == ExpenseTracker.Models.TransactionType.Income ? "amount-income" : "amount-expense")">
                                @(t.Type == ExpenseTracker.Models.TransactionType.Income ? "+" : "-") ₹ @(t.Amount.ToString("N2"))
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5" style="color: var(--text-muted);">
                            <div style="font-size: 1.1rem; font-weight: 500; margin-bottom: 6px;">No transactions found</div>
                            <div style="font-size: 0.85rem;">There are no transactions recorded for your @Model.AccountName account during @Model.PeriodLabel.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Print Only Footer Branding -->
    <div class="print-only-footer d-none d-print-block">
        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4" style="font-size: 0.85rem; color: #7A7265;">
            <div>
                <strong style="color: var(--primary-green); font-family: var(--font-serif);">ExpenseTracker</strong> &bull; Created by Mehul Bharadva
            </div>
            <div>
                Financial Statement &bull; @Model.AccountName Account
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        @@page {
            size: auto;
            margin: 12mm 15mm 15mm 15mm;
        }

        /* 1. Reset root layout containers to avoid Chromium flex fragmentation bugs */
        html, body {
            background-color: #FFFFFF !important;
            background: #FFFFFF !important;
            color: #000000 !important;
            font-size: 11pt !important;
            display: block !important;
            height: auto !important;
            min-height: 0 !important;
            width: 100% !important;
            overflow: visible !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .main-content {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            overflow: visible !important;
        }

        .container, .reports-container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* 2. Hide interactive & non-printable elements */
        .app-navbar,
        footer,
        .app-footer,
        .no-print,
        .filter-row,
        .btn-primary-theme,
        .btn-secondary-theme,
        .title-gold-bar {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* 3. Header */
        .print-only-header {
            display: block !important;
            margin-bottom: 20px !important;
        }

        /* 4. Metric summary cards */
        .metric-grid {
            display: flex !important;
            flex-direction: row !important;
            gap: 12px !important;
            margin-bottom: 20px !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .metric-card {
            flex: 1 !important;
            border: 1px solid #CCCCCC !important;
            border-top: 3.5px solid !important;
            box-shadow: none !important;
            padding: 12px 16px !important;
            background: #FFFFFF !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .metric-card.accent-income {
            border-top-color: var(--primary-green) !important;
        }

        .metric-card.accent-expense {
            border-top-color: var(--expense-wine) !important;
        }

        .metric-card.accent-balance {
            border-top-color: var(--accent-gold) !important;
        }

        .metric-value {
            font-size: 1.4rem !important;
            color: #000000 !important;
        }

        .metric-value.val-income {
            color: var(--primary-green) !important;
        }

        .metric-value.val-expense {
            color: var(--expense-wine) !important;
        }

        .metric-value.val-balance {
            color: #000000 !important;
        }

        /* 5. Transactions Table */
        .table-card {
            border: 1px solid #CCCCCC !important;
            box-shadow: none !important;
            padding: 0 !important;
            overflow: visible !important;
            border-radius: 0 !important;
        }

        .table-custom {
            width: 100% !important;
            border-collapse: collapse !important;
        }

        .table-custom thead {
            display: table-header-group !important;
        }

        .table-custom tr {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .table-custom th {
            background-color: #F5F2EC !important;
            color: #000000 !important;
            border-bottom: 1.5px solid #333333 !important;
            font-size: 9pt !important;
            padding: 8px 10px !important;
        }

        .table-custom td {
            border-bottom: 1px solid #E5E0D8 !important;
            font-size: 9pt !important;
            padding: 8px 10px !important;
            color: #000000 !important;
            vertical-align: middle !important;
        }

        .badge-cat-pill {
            border: 1px solid #CCCCCC !important;
            background: transparent !important;
            color: #000000 !important;
            padding: 2px 6px !important;
        }

        /* 6. Print Footer Branding */
        .print-only-footer {
            display: block !important;
            margin-top: 24px !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
    }
</style>

<script>
    function printReport() {
        // Blur active element to remove focus ring before printing
        if (document.activeElement && typeof document.activeElement.blur === 'function') {
            document.activeElement.blur();
        }

        // Wait for fonts/styles to settle before triggering print dialog so PDF generator completes cleanly
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
                setTimeout(function () {
                    window.print();
                }, 100);
            });
        } else {
            setTimeout(function () {
                window.print();
            }, 100);
        }
    }
</script>
