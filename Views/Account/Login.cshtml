@model ExpenseTracker.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container" style="max-width: 480px; margin-top: 30px;">
    <div class="theme-card" style="padding: 36px 32px;">
        <h1 class="page-title text-center" style="font-size: 2.1rem; margin-top: 0;">Welcome Back</h1>
        <div class="title-gold-bar mx-auto" style="margin-bottom: 24px;"></div>
        <p class="text-center" style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 28px;">
            Sign in to track your personal &amp; business expenses.
        </p>

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label" style="font-weight: 500; color: #4A453E; font-size: 0.9rem;">Username or Email</label>
                <input asp-for="UserNameOrEmail" class="form-control-theme" placeholder="name@example.com" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label" style="font-weight: 500; color: #4A453E; font-size: 0.9rem;"></label>
                <input asp-for="Password" class="form-control-theme" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label" style="font-size: 0.9rem; color: #555047;">Remember me</label>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn-primary-theme" style="padding: 10px; font-size: 1rem;">Login</button>
            </div>

            <div class="text-center mt-4" style="font-size: 0.9rem; color: var(--text-muted);">
                Don't have an account? <a asp-action="Register" style="color: var(--primary-green); font-weight: 600; text-decoration: underline;">Register here</a>
            </div>
        </form>
    </div>
</div>
