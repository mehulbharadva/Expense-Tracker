using ExpenseTracker.Models;
using Microsoft.AspNetCore.Identity.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore;

namespace ExpenseTracker.Data
{
    // Use IdentityDbContext so ASP.NET Core Identity tables can be stored via EF Core (using Pomelo/MySQL)
    public class ApplicationDbContext : IdentityDbContext<ApplicationUser>
    {
        public ApplicationDbContext(DbContextOptions<ApplicationDbContext> options) : base(options)
        {
        }

        public DbSet<Transaction> Transactions { get; set; }
        public DbSet<Category> Categories { get; set; }

        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            base.OnModelCreating(modelBuilder);

            // Seed basic categories (optional for initial setup; can be removed if you don't want automatic seeding)
            modelBuilder.Entity<Category>().HasData(
                new Category { Id = 1, Name = "Food" },
                new Category { Id = 2, Name = "Shopping" },
                new Category { Id = 3, Name = "Transport" },
                new Category { Id = 4, Name = "Bills" },
                new Category { Id = 5, Name = "Entertainment" },
                new Category { Id = 6, Name = "Education" },
                new Category { Id = 7, Name = "Health" },
                new Category { Id = 8, Name = "Other" }
            );
        }
    }
}
