:root{
  --bg-900:#071020; /* deep navy */
  --bg-800:#0c1928; /* secondary surface */
  --card:#0f2436;
  --muted:#9aa6b2;
  --text:#e6eef7;
  --accent-start:#3aa0ff; /* electric blue */
  --accent-end:#7c3aed; /* violet */
  --income:#10b981; /* emerald */
  --expense:#ef476f; /* pink/red */
  --balance:#6d28d9; /* blue/violet */
  --glass: rgba(255,255,255,0.04);
  --glass-border: rgba(125,180,255,0.07);
}

html{font-size:14px;position:relative;min-height:100%;background:linear-gradient(180deg,var(--bg-900),#041421);color:var(--text)}
@media(min-width:768px){html{font-size:16px}}

/* --- App shell --- */
.app-shell{display:flex;min-height:100vh}
.app-sidebar{width:260px;background:linear-gradient(180deg,var(--bg-800),#081827);padding-bottom:24px;border-right:1px solid rgba(255,255,255,0.03);backdrop-filter: blur(6px)}
.app-main{flex:1;display:flex;flex-direction:column}
.app-topbar{height:64px;border-bottom:1px solid rgba(255,255,255,0.03);background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent)}
.app-content{flex:1;background:transparent}

.brand{border-bottom:1px solid rgba(255,255,255,0.02)}
.brand-link{color:var(--text)}
.brand-mark svg rect{filter:drop-shadow(0 4px 16px rgba(20,40,80,0.6))}
.brand-text .text-muted{color:var(--muted)}

.sidebar-nav{margin-top:8px}
.sidebar-item{display:block;padding:12px 14px;border-radius:10px;color:var(--muted);margin:6px 6px;transition:all .18s cubic-bezier(.2,.9,.24,1)}
.sidebar-item .nav-icon{display:inline-block;width:22px}
.sidebar-item:hover{color:var(--text);transform:translateY(-2px);background:linear-gradient(90deg,var(--accent-start),var(--accent-end));background-clip:padding-box;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.02)}
.sidebar-item.active{color:var(--text);background:linear-gradient(90deg,rgba(58,160,255,0.12),rgba(124,58,237,0.12));border-left:3px solid rgba(124,58,237,0.9);box-shadow:0 6px 18px rgba(10,20,40,0.6)}

/* Buttons */
.btn-ghost{background:transparent;border:1px solid rgba(255,255,255,0.04);color:var(--text);padding:.5rem .75rem;border-radius:8px}
.btn-icon{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.03);color:var(--text);padding:.5rem;border-radius:10px}
.btn-search{background:transparent;border:0;color:var(--muted);padding:.35rem .5rem}
.form-control-search{background:var(--glass);border:1px solid var(--glass-border);color:var(--text);border-radius:12px;padding:.5rem .75rem;width:360px}

/* Avatar */
.avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(180deg,var(--bg-800),var(--card));border:1px solid rgba(255,255,255,0.04)}

/* Content containers */
.container{max-width:1200px}
.app-content .container{padding-top:8px}

/* Cards */
.card{background:linear-gradient(180deg,rgba(255,255,255,0.02),transparent);border:1px solid rgba(255,255,255,0.03);border-radius:14px;padding:16px;color:var(--text);box-shadow:0 8px 30px rgba(6,12,20,0.6)}
.card .muted{color:var(--muted)}

.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.summary-card{position:relative;overflow:hidden;padding:20px;border-radius:14px;background:linear-gradient(180deg,var(--card),rgba(255,255,255,0.02));transition:transform .22s ease,box-shadow .22s ease}
.summary-card:hover{transform:translateY(-6px);box-shadow:0 18px 40px rgba(13,24,40,0.7)}
.summary-card .label{color:var(--muted);font-size:0.9rem}
.summary-card .value{font-weight:700;font-size:1.6rem}
.summary-card .change{font-size:0.85rem;color:var(--muted);margin-top:6px}
.sparkline{position:absolute;right:8px;bottom:6px;opacity:.18}

.income{color:var(--income)}
.expense{color:var(--expense)}
.balance{color:var(--balance)}

/* Transactions table */
.transactions-table{width:100%;border-collapse:collapse}
.transactions-table th{color:var(--muted);font-weight:600;padding:12px;text-align:left}
.transactions-table td{padding:12px;border-top:1px solid rgba(255,255,255,0.02)}
.tx-amount{font-weight:700}
.tx-income{color:var(--income)}
.tx-expense{color:var(--expense)}

/* Quick actions */
.quick-actions{display:flex;flex-direction:column;gap:12px}
.quick-action{display:flex;align-items:center;gap:12px;padding:12px;border-radius:12px;background:linear-gradient(90deg,rgba(58,160,255,0.06),rgba(124,58,237,0.04));border:1px solid rgba(255,255,255,0.03);cursor:pointer}

/* Responsive */
@media(max-width:991px){
  .app-sidebar{position:fixed;left:-320px;top:0;height:100vh;z-index:1040;transition:left .28s ease}
  .app-sidebar.open{left:0}
  .app-shell{padding-left:0}
  .form-control-search{width:220px}
  .summary-grid{grid-template-columns:repeat(1,1fr)}
}

@media(prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
}

/* small utilities */
.text-muted{color:var(--muted)!important}

