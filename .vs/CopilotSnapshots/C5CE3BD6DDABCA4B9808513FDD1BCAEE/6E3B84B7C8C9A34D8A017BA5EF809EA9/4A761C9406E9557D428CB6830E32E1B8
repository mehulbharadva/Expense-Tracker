@{
    ViewData["Title"] = "Dashboard";
    var recent = ViewData["RecentTransactions"] as IEnumerable<ExpenseTracker.Models.Transaction> ?? Enumerable.Empty<ExpenseTracker.Models.Transaction>();
    decimal totalIncome = (decimal)(ViewData["TotalIncome"] ?? 0m);
    decimal totalExpense = (decimal)(ViewData["TotalExpense"] ?? 0m);
    decimal balance = (decimal)(ViewData["Balance"] ?? 0m);
    var selectedAccount = ViewData["SelectedAccount"];
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="mb-1">Good to see you</h2>
            <div class="text-muted">Overview of your recent financial activity</div>
        </div>

        <div class="d-flex align-items-center">
            <div class="me-3 text-muted">View:</div>
            <a class="btn btn-ghost me-1 @( (selectedAccount != null && (int)selectedAccount == 1) ? "active" : "" )" href="/Dashboard?account=1">Personal</a>
            <a class="btn btn-ghost @( (selectedAccount != null && (int)selectedAccount == 2) ? "active" : "" )" href="/Dashboard?account=2">Business</a>
        </div>
    </div>

    <section class="summary-grid mb-4">
        <div class="summary-card card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="label">Total Income</div>
                    <div class="value income">@String.Format("{0:C}", totalIncome)</div>
                    <div class="change muted">Last 5 tx total: @String.Format("{0:C}", recent.Where(r=>r.Type==ExpenseTracker.Models.TransactionType.Income).Sum(r=>r.Amount))</div>
                </div>
                <div class="sparkline" aria-hidden="true">
                    <svg width="120" height="48" viewBox="0 0 120 48" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="gIncome" x1="0" x2="1"><stop offset="0%" stop-color="var(--accent-start)"/><stop offset="100%" stop-color="var(--accent-end)"/></linearGradient>
                        </defs>
                        <polyline fill="none" stroke="url(#gIncome)" stroke-width="3" points="0,30 30,18 60,22 90,12 120,8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="summary-card card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="label">Total Expense</div>
                    <div class="value expense">@String.Format("{0:C}", totalExpense)</div>
                    <div class="change muted">Last 5 tx total: @String.Format("{0:C}", recent.Where(r=>r.Type==ExpenseTracker.Models.TransactionType.Expense).Sum(r=>r.Amount))</div>
                </div>
                <div class="sparkline" aria-hidden="true">
                    <svg width="120" height="48" viewBox="0 0 120 48" preserveAspectRatio="none">
                        <polyline fill="none" stroke="var(--expense)" stroke-width="3" points="0,18 30,24 60,26 90,30 120,36" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="summary-card card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="label">Balance</div>
                    <div class="value balance">@String.Format("{0:C}", balance)</div>
                    <div class="change muted">Income vs Expense</div>
                </div>
                <div class="sparkline" aria-hidden="true">
                    <svg width="120" height="48" viewBox="0 0 120 48" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="gBal" x1="0" x2="1"><stop offset="0%" stop-color="#6ee7b7"/><stop offset="100%" stop-color="#7c3aed"/></linearGradient>
                        </defs>
                        <rect x="10" y="12" width="30" height="24" rx="6" fill="url(#gBal)" opacity="0.12" />
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Income vs Expense</h5>
                    <small class="text-muted">This period</small>
                </div>
                <div class="p-2">
                    <!-- simple comparison bars built from totals -->
                    @{
                        var max = Math.Max((double)totalIncome, (double)totalExpense);
                        var incPct = max <= 0 ? 50 : (int)((double)totalIncome / max * 100);
                        var expPct = max <= 0 ? 50 : (int)((double)totalExpense / max * 100);
                    }
                    <div style="display:flex;gap:12px;align-items:center">
                        <div style="flex:1">
                            <div class="text-muted">Income</div>
                            <div style="height:12px;background:rgba(255,255,255,0.03);border-radius:8px;overflow:hidden;margin-top:6px">
                                <div style="width:@incPct%;height:100%;background:linear-gradient(90deg,var(--accent-start),var(--accent-end));border-radius:8px"></div>
                            </div>
                        </div>
                        <div style="width:12px"></div>
                        <div style="flex:1">
                            <div class="text-muted">Expense</div>
                            <div style="height:12px;background:rgba(255,255,255,0.03);border-radius:8px;margin-top:6px">
                                <div style="width:@expPct%;height:100%;background:linear-gradient(90deg,var(--expense),rgba(255,100,150,0.8));border-radius:8px"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <h5>Spending by Category (recent)</h5>
                <div class="mt-2">
                    @{
                        var byCat = recent.Where(r => r.Category != null && r.Type == ExpenseTracker.Models.TransactionType.Expense)
                                         .GroupBy(r => r.Category.Name)
                                         .Select(g => new { Name = g.Key, Total = g.Sum(x => x.Amount) })
                                         .OrderByDescending(x => x.Total)
                                         .ToList();
                    }
                    @if (!byCat.Any())
                    {
                        <div class="text-muted">No recent category data to display.</div>
                    }
                    else
                    {
                        var maxCat = byCat.Max(x => x.Total);
                        foreach (var c in byCat)
                        {
                            var pct = maxCat == 0 ? 0 : (int)(c.Total / maxCat * 100);
                            <div class="d-flex align-items-center mb-2">
                                <div style="width:160px" class="text-truncate">@c.Name</div>
                                <div class="flex-fill mx-3" style="height:10px;background:rgba(255,255,255,0.03);border-radius:6px;overflow:hidden">
                                    <div style="width:@pct%;height:100%;background:linear-gradient(90deg,var(--expense),rgba(255,100,150,0.8));border-radius:6px"></div>
                                </div>
                                <div class="text-muted ms-2">@String.Format("{0:C}", c.Total)</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <h5>Quick Actions</h5>
                <div class="quick-actions mt-3">
                    <a class="quick-action" href="/Transactions/Create?account=@(ViewData["SelectedAccount"] ?? 1)&type=1"><strong>?</strong> Add Income</a>
                    <a class="quick-action" href="/Transactions/Create?account=@(ViewData["SelectedAccount"] ?? 1)&type=2"><strong>?</strong> Add Expense</a>
                    <a class="quick-action" href="/Categories/Create"><strong>?</strong> Add Category</a>
                    <a class="quick-action" href="/Transactions"><strong>??</strong> View Transactions</a>
                </div>
            </div>

            <div class="card">
                <h5>Recent Transactions</h5>
                <div class="mt-2">
                    <table class="transactions-table">
                        <thead>
                            <tr><th>Date</th><th>Category</th><th>Description</th><th class="text-end">Amount</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in recent)
                            {
                                <tr>
                                    <td>@t.TransactionDate.ToString("yyyy-MM-dd")</td>
                                    <td>@t.Category?.Name</td>
                                    <td>@t.Description</td>
                                    <td class="text-end tx-amount @(t.Type==ExpenseTracker.Models.TransactionType.Income?"tx-income":"tx-expense")">@String.Format("{0:C}", t.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
